# ==================================================================
# AutoClip Universal Environment Configuration Template
# Copy this file to .env and fill in your values, or run:
# python setup_wizard.py
# ==================================================================

# Discord Bot Integration (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_guild_id

# Target Channel & Niche Configuration
TARGET_NICHE=General / Universal
YOUTUBE_CHANNEL_NAME=My Video Channel
YOUTUBE_CHANNEL_HANDLE=@MyVideoChannel
DEFAULT_CREATOR=universal

# Active Editing Workflow Preset
# Options: universal_auto, countdown_montage, smart_highlights, podcast_split, commentary_explainer
DEFAULT_WORKFLOW=universal_auto

# Directory Paths
DATA_DIR=data
SFX_DIR=data/sfx
MUSIC_DIR=data/music
FONTS_DIR=fonts

# Optional Composio YouTube Studio Direct Upload Integration
COMPOSIO_API_KEY=
COMPOSIO_ACCOUNT_ID=

# Optional AI LLM API Keys (for enhanced title and viral hook synthesis)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
